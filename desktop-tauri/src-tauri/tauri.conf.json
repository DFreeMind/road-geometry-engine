{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "路境",
  "version": "0.2.0",
  "identifier": "com.roadgeometry.lujing",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "路境 · 道路设计工作台",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "resources/catalog.json": "catalog.json",
      "resources/engine/": "engine/",
      "resources/gis/": "gis/"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true }
    }
  }
}
