{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workbench",
  "description": "主工作台的本地文件选择和窗口能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm"
  ]
}
